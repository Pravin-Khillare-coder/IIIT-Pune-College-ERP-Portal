# IIIT Pune College ERP - Environment Variable Template

# Environment & Server
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="IIIT Pune College ERP Portal"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production_32bytes_minimum

# Database Configuration (PostgreSQL)
# Use PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iiitp_erp

# File Upload & Storage Configuration
# Local storage path outside public web server root
UPLOAD_STORAGE_DIR=../storage/uploads
MAX_UPLOAD_SIZE_BYTES=5242880  # 5MB

# Integration Settings (Admin Configurable Default Fallbacks)
SBI_COLLECT_URL=https://www.onlinesbi.sbi/sbicollect/
ANTI_RAGGING_FORM_URL=https://www.antiragging.in/

# CORS Settings (Comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
